{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "milestone_id", "inputs", "candidate", "control"],
  "properties": {
    "schema": { "const": "m8m.branch_control_request.v1" },
    "milestone_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "inputs": { "type": "object" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs"],
      "properties": { "outputs": { "type": "object" } }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "paths", "default", "join"],
      "properties": {
        "kind": { "const": "branch" },
        "paths": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true
        },
        "default": { "type": "string" },
        "join": { "type": "string" }
      }
    }
  }
}
