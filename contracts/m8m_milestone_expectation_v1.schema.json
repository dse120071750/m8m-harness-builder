{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m8m_milestone_expectation_v1.schema.json",
  "title": "M8M milestone expectation v1",
  "description": "A run-independent projection of the authored success rule and declared output ports for one flowstep_flow_v4 milestone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "milestone_id",
    "success",
    "output_contract",
    "output_schema_ref",
    "outputs"
  ],
  "properties": {
    "schema": { "const": "m8m.milestone_expectation.v1" },
    "milestone_id": { "$ref": "#/$defs/id" },
    "success": { "$ref": "#/$defs/nonemptyTrimmed" },
    "output_contract": { "allOf": [{ "$ref": "#/$defs/nonemptyTrimmed" }, { "minLength": 3 }] },
    "output_schema_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\S|\\S.*\\S)$"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/output" },
      "contains": { "$ref": "#/$defs/requiredOutput" },
      "minContains": 1
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "cardinality", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonemptyTrimmed" },
        "kind": { "enum": ["json", "data", "file", "image", "video", "audio"] },
        "cardinality": { "enum": ["one", "many"] },
        "required": { "type": "boolean" }
      }
    },
    "requiredOutput": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": { "const": true }
      }
    },
    "nonemptyTrimmed": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\S|\\S.*\\S)$"
    }
  }
}
