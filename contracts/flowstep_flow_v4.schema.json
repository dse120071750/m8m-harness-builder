{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flowstep_flow_v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "flow_id", "version", "milestones"],
  "properties": {
    "schema": { "const": "flowstep_flow_v4" },
    "flow_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "context_policy": { "const": "isolated" },
    "max_run_seconds": { "type": "integer", "minimum": 1 },
    "artifact_root": { "type": "string", "minLength": 1 },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/milestone" }
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "cardinality", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["json", "data", "file", "image", "video", "audio"] },
        "cardinality": { "enum": ["one", "many"] },
        "required": { "type": "boolean" }
      }
    },
    "binding": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from"],
          "properties": {
            "from": { "type": "string", "minLength": 3 },
            "output": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "member": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        }
      ]
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reuse", "ttl_seconds", "side_effects"],
      "properties": {
        "reuse": { "const": "candidate" },
        "ttl_seconds": { "type": "integer", "minimum": 1 },
        "side_effects": { "const": "none" }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "success",
        "output_contract",
        "output_schema",
        "outputs",
        "handler"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "success": { "type": "string", "minLength": 1 },
        "output_contract": { "type": "string", "minLength": 3 },
        "output_schema": { "type": "string", "minLength": 1 },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } },
        "handler": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 },
        "input_schema": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/binding" }
        },
        "flowsteps": { "type": "array", "items": { "type": ["object", "string"] } },
        "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "intelligence": { "enum": ["none", "completion", "image", "judge"] },
        "model_justification": { "type": "string" },
        "draft_schema": { "type": "string", "minLength": 1 },
        "on_tool_fail": { "enum": ["need_model", "BLOCKED"] },
        "max_model_attempts": { "type": "integer", "minimum": 1 },
        "loop": { "enum": ["none", "for", "judge"] },
        "worker": { "type": "string", "minLength": 1 },
        "receipt_schema": { "type": "string", "minLength": 1 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "ledger": { "type": "object" },
        "branch": { "type": "object" },
        "on_path": { "type": "string", "minLength": 1 },
        "cycle": { "type": "object" },
        "on_cycle": { "type": "string", "minLength": 1 },
        "gem": { "type": "string", "minLength": 1 },
        "next": { "type": "array" },
        "else": { "type": "string" },
        "join": { "type": ["array", "string"] },
        "cache": { "$ref": "#/$defs/cache" }
      }
    }
  }
}
