{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m8m_workflow_source_bundle_v1.schema.json",
  "title": "M8M workflow source bundle v1",
  "description": "Deterministic, base-independent Builder 3.1 output. It is advisory source evidence, not a runnable release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_bundle",
    "definition",
    "definition_digest",
    "workflow_contracts",
    "workflow_contracts_digest",
    "resources",
    "resource_requirements_digest",
    "implementation_requirements",
    "implementation_requirements_digest",
    "agent_profile_requirements",
    "agent_profile_requirements_digest",
    "capability_requirements",
    "capability_requirements_digest",
    "observer",
    "observer_digest",
    "local_validation",
    "local_validation_digest",
    "source_bundle_proof"
  ],
  "properties": {
    "schema": { "const": "m8m.workflow_source_bundle.v1" },
    "contract_bundle": {
      "$ref": "m8m_contract_bundle_lock_v1.schema.json"
    },
    "definition": {
      "$ref": "flowstep_flow_v4.schema.json"
    },
    "definition_digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" },
    "workflow_contracts": {
      "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowContracts"
    },
    "workflow_contracts_digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" },
    "resources": {
      "type": "array",
      "items": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/resource" }
    },
    "resource_requirements_digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" },
    "implementation_requirements": {
      "type": "array",
      "items": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/implementationRequirement" }
    },
    "implementation_requirements_digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" },
    "agent_profile_requirements": {
      "type": "array",
      "items": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/agentProfileRequirement" }
    },
    "agent_profile_requirements_digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" },
    "capability_requirements": {
      "type": "array",
      "items": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/capabilityRequirement" }
    },
    "capability_requirements_digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" },
    "observer": { "type": "object" },
    "observer_digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" },
    "local_validation": {
      "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/localValidation"
    },
    "local_validation_digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" },
    "source_bundle_proof": {
      "$ref": "m8m_workflow_source_bundle_proof_v1.schema.json"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "localValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "builder",
        "policy_version",
        "contract_bundle_digest",
        "status",
        "findings_count",
        "advisory"
      ],
      "properties": {
        "schema": { "const": "m8m.builder_validation_summary.v1" },
        "builder": { "const": "m8m-harness-builder/3.1" },
        "policy_version": { "const": "m8m-builder-validation/3" },
        "contract_bundle_digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" },
        "status": { "enum": ["SOURCE_VALID", "BUILD_REQUIRED"] },
        "findings_count": { "type": "integer", "minimum": 0 },
        "advisory": { "const": true }
      }
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^:]+$"
    },
    "workflowSchemaRef": {
      "type": "string",
      "minLength": 6,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[*?\\[])(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^:\\u0000-\\u001F\\u007F]+\\.json$"
    },
    "workflowIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "workflowContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestones",
        "entry_milestones",
        "terminal_milestones"
      ],
      "dependentRequired": {
        "request_schema": [
          "configuration_schema",
          "result_schema",
          "terminal_bindings"
        ],
        "configuration_schema": [
          "request_schema",
          "result_schema",
          "terminal_bindings"
        ],
        "result_schema": [
          "request_schema",
          "configuration_schema",
          "terminal_bindings"
        ],
        "terminal_bindings": [
          "request_schema",
          "configuration_schema",
          "result_schema"
        ]
      },
      "properties": {
        "request_schema": {
          "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowSchemaRef"
        },
        "configuration_schema": {
          "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowSchemaRef"
        },
        "result_schema": {
          "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowSchemaRef"
        },
        "terminal_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowTerminalBinding"
          }
        },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowMilestone"
          }
        },
        "entry_milestones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowIdentifier"
          }
        },
        "terminal_milestones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowIdentifier"
          }
        }
      }
    },
    "workflowTerminalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "from", "output"],
      "properties": {
        "name": {
          "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowIdentifier"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "output": {
          "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowIdentifier"
        }
      }
    },
    "workflowMilestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone_id",
        "input_schema",
        "inputs",
        "output_contract",
        "output_schema",
        "outputs"
      ],
      "properties": {
        "milestone_id": {
          "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowIdentifier"
        },
        "input_schema": {
          "oneOf": [
            { "const": "" },
            {
              "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowSchemaRef"
            }
          ]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "flowstep_flow_v4.schema.json#/$defs/binding"
          }
        },
        "output_contract": {
          "allOf": [
            { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            { "minLength": 3 }
          ]
        },
        "output_schema": {
          "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowSchemaRef"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "flowstep_flow_v4.schema.json#/$defs/output"
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "kind",
        "role",
        "source_path",
        "media_type",
        "byte_count",
        "digest"
      ],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_path": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/safeRelativePath" },
        "media_type": { "type": "string", "minLength": 3, "maxLength": 255 },
        "byte_count": { "type": "integer", "minimum": 0 },
        "digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" }
      }
    },
    "implementationRequirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "kind",
            "role",
            "runtime_abi",
            "entrypoint",
            "build_state"
          ],
          "properties": {
            "ref": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "kind": {
              "enum": ["milestone_handler", "milestone_judge", "shared_dependency"]
            },
            "role": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "runtime_abi": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "entrypoint": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "build_state": { "enum": ["built", "BUILD_REQUIRED"] },
            "milestone_id": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowIdentifier" },
            "digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 0 }
          },
          "allOf": [
            {
              "if": { "properties": { "kind": { "const": "milestone_handler" } } },
              "then": {
                "properties": {
                  "runtime_abi": { "const": "m8m_milestone_handler_v1" }
                }
              }
            },
            {
              "if": { "properties": { "kind": { "const": "milestone_judge" } } },
              "then": {
                "properties": {
                  "runtime_abi": { "const": "m8m_milestone_judge_v1" }
                }
              }
            },
            {
              "if": { "properties": { "kind": { "const": "shared_dependency" } } },
              "then": {
                "properties": {
                  "runtime_abi": { "const": "m8m_shared_dependency_v1" }
                }
              }
            },
            {
              "if": {
                "properties": { "build_state": { "const": "built" } },
                "required": ["build_state"]
              },
              "then": { "required": ["digest", "byte_count"] }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "kind",
            "role",
            "runtime_abi",
            "entrypoint",
            "build_state"
          ],
          "properties": {
            "ref": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "kind": { "const": "flowstep_tool" },
            "role": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "runtime_abi": { "const": "m8m_flowstep_tool_v1" },
            "entrypoint": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "build_state": { "enum": ["built", "BUILD_REQUIRED"] },
            "local_name": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowIdentifier" },
            "digest": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/sha256" },
            "member_count": { "type": "integer", "minimum": 0 }
          },
          "allOf": [
            {
              "if": {
                "properties": { "build_state": { "const": "built" } },
                "required": ["build_state"]
              },
              "then": { "required": ["digest", "member_count"] }
            }
          ]
        }
      ]
    },
    "agentProfileRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "milestone_id", "role", "build_state"],
      "properties": {
        "ref": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
        "milestone_id": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowIdentifier" },
        "role": { "enum": ["candidate_executor", "ai_judge"] },
        "build_state": { "enum": ["built", "BUILD_REQUIRED"] },
        "executor_ref": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
        "gem_ref": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
        "schema_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_schema", "output_schema"],
          "properties": {
            "input_schema": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "draft_schema": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "output_schema": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "receipt_schema": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" }
          }
        },
        "tool_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" }
        },
        "capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" }
        },
        "model_configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "reasoning"],
          "properties": {
            "model": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "reasoning": {
              "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
            },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        "token_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_input_tokens", "max_output_tokens"],
          "properties": {
            "max_input_tokens": { "type": "integer", "minimum": 1 },
            "max_output_tokens": { "type": "integer", "minimum": 1 }
          }
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "missing": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "candidate_executor" } },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "schema_refs": {
                "required": ["input_schema", "draft_schema", "output_schema"],
                "not": { "required": ["receipt_schema"] }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "role": { "const": "ai_judge" } },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "schema_refs": {
                "required": ["input_schema", "output_schema", "receipt_schema"],
                "not": { "required": ["draft_schema"] }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "build_state": { "const": "built" } },
            "required": ["build_state"]
          },
          "then": {
            "required": [
              "executor_ref",
              "gem_ref",
              "schema_refs",
              "tool_refs",
              "capability_ids",
              "model_configuration",
              "token_budget",
              "timeout_seconds"
            ],
            "not": { "required": ["missing"] }
          },
          "else": { "required": ["missing"] }
        }
      ]
    },
    "capabilityRequirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "ref", "milestone_id", "access", "side_effects", "build_state"],
          "properties": {
            "id": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" },
            "ref": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "milestone_id": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/workflowIdentifier" },
            "access": { "enum": ["read", "write", "execute", "use"] },
            "side_effects": { "enum": ["none", "local", "external"] },
            "build_state": { "enum": ["built", "BUILD_REQUIRED"] },
            "phase_journal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "operator_result_path", "resume"],
              "properties": {
                "path": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/safeRelativePath" },
                "operator_result_path": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/safeRelativePath" },
                "resume": { "const": "query_exact_operation" }
              }
            },
            "missing": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "m8m_workflow_source_bundle_v1.schema.json#/$defs/nonemptyTrimmed" }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "build_state": { "const": "BUILD_REQUIRED" } },
                "required": ["build_state"]
              },
              "then": { "required": ["missing"] },
              "else": { "not": { "required": ["missing"] } }
            },
            {
              "if": {
                "properties": {
                  "side_effects": { "const": "external" },
                  "build_state": { "const": "built" }
                },
                "required": ["side_effects", "build_state"]
              },
              "then": { "required": ["phase_journal"] }
            }
          ]
        }
      ]
    },
    "nonemptyTrimmed": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\S|\\S.*\\S)$"
    }
  }
}
