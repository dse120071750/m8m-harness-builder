{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m8m_runtime_release_v1.schema.json",
  "title": "Immutable M8M runtime release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runtime_name",
    "runtime_version",
    "runtime_id",
    "cli_abi",
    "entrypoint",
    "python_abi",
    "python_executable_digest",
    "dependencies",
    "payload_digest",
    "members"
  ],
  "properties": {
    "schema": { "const": "m8m.runtime_release.v1" },
    "runtime_name": { "const": "m8m-runtime" },
    "runtime_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "runtime_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cli_abi": { "const": "m8m_runtime_cli_v1" },
    "entrypoint": { "const": "scripts/run_flow.py" },
    "python_abi": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "python_executable_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "vendor_path", "file_count", "files_digest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "vendor_path": { "type": "string", "pattern": "^vendor/[a-z0-9][a-z0-9-]*$" },
          "file_count": { "type": "integer", "minimum": 1 },
          "files_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "payload_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byte_count", "digest"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:scripts|contracts|vendor)/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^:]+$"
          },
          "byte_count": { "type": "integer", "minimum": 0 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
