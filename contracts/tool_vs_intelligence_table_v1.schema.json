{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_vs_intelligence_table_v1.schema.json",
  "title": "F8F tool vs intelligence table",
  "description": "Required classification before generate. A row is one toolbox function or one milestone intelligence. Columns are fixed: id, class, test, why.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rows"],
  "properties": {
    "schema": { "const": "tool_vs_intelligence_table_v1" },
    "flow_id": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "test", "why"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$" },
        "class": { "enum": ["tool", "intelligence"] },
        "test": {
          "type": "string",
          "minLength": 1,
          "description": "Which of the four tests decided the class: same-input, fixture, receipt, junior-schema."
        },
        "why": { "type": "string", "minLength": 1 },
        "milestone": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "destination": { "type": "string", "minLength": 1 }
      }
    }
  }
}
