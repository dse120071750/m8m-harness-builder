{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m8m_source_asset_manifest_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "policy", "assets", "created_at"],
  "properties": {
    "schema": { "const": "m8m_source_asset_manifest_v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "policy": { "const": "copy_once_hash_verified" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "bytes", "materialized_path", "source_paths"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "materialized_path": { "type": "string", "pattern": "^inputs/source-assets/" },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
