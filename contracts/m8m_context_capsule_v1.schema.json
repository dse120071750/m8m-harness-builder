{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m8m_context_capsule_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "flow_id",
    "milestone_id",
    "attempt",
    "prior_feedback",
    "expectation",
    "context_policy",
    "chat_history_allowed",
    "allowed_files",
    "write_file",
    "instruction",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "m8m_context_capsule_v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "flow_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "milestone_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "prior_feedback": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["judge_attempt", "reasons", "blockers"],
          "properties": {
            "judge_attempt": { "type": "integer", "minimum": 1 },
            "reasons": {
              "type": "array",
              "maxItems": 8,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "blockers": {
              "type": "array",
              "maxItems": 8,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        }
      ]
    },
    "expectation": { "$ref": "m8m_milestone_expectation_v1.schema.json" },
    "context_policy": { "const": "isolated" },
    "chat_history_allowed": { "const": false },
    "allowed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "write_file": { "type": "string", "minLength": 1 },
    "instruction": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
