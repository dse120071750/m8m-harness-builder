{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m8m_context_capsule_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "flow_id",
    "milestone_id",
    "context_policy",
    "chat_history_allowed",
    "allowed_files",
    "write_file",
    "instruction",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "m8m_context_capsule_v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "flow_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "milestone_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "context_policy": { "const": "isolated" },
    "chat_history_allowed": { "const": false },
    "allowed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "write_file": { "type": "string", "minLength": 1 },
    "instruction": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
