{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "label.output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "sentence"],
  "properties": {
    "label": { "enum": ["question", "statement", "other"] },
    "sentence": { "type": "string", "minLength": 1 }
  }
}
