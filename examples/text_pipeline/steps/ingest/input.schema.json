{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ingest.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request"],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
