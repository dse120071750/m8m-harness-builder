{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ingest.output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "char_count"],
  "properties": {
    "text": { "type": "string", "minLength": 1 },
    "char_count": { "type": "integer", "minimum": 1 }
  }
}
